<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <NoWarn>$(NoWarn);CA1707;CA1716;CA1720;CA1724;CA1805;CA1062;CA1303;CA1305;CA1310;CA1311;CA1304;CA1309;CA1814;CA1819;CA1822;CA1848;CA1859;CA1860;CA1861;CA1865;CA1866;CA1873;CA2000;CA2211;CA1031;CA1032;CA1064;CA1002;CA1034;CA1051;CA1308;CA1508;CA1515;CA1711;CA1725;CA1852;CA1812;CA5394;CA1416;CA1838;CA1401;CA2101;SYSLIB1054;SYSLIB1096;CS1591</NoWarn>
    <Authors>Imagine contributors</Authors>
    <Product>Imagine</Product>
    <Version>0.1.0</Version>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
</Project>
